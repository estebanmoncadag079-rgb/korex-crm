# ============================================================
# Vocero CRM — variables de entorno
# Copia este archivo a `.env` y reemplaza cada REEMPLAZA_...
# En producción estas variables van en tu plataforma de hosting
# (Coolify / docker compose), no solo en el archivo.
# ============================================================

# --- Aplicación ---------------------------------------------
# URL pública de la instancia (con https en producción).
# De ella se construye la URL del webhook de WhatsApp.
APP_BASE_URL=REEMPLAZA_https://crm.tudominio.com

# WhatsApp de la agencia (solo dígitos, con indicativo) para el enlace de
# asesoría del login. Vacío = no se muestra el enlace.
SUPPORT_WHATSAPP=

# Otros dominios públicos desde los que se entra a la app (coma).
# OBLIGATORIO si APP_BASE_URL es la URL interna detrás de un proxy: sin el
# dominio real aquí, el login del navegador falla con 403 "Invalid origin".
APP_TRUSTED_ORIGINS=https://crm.tudominio.com,https://tudominio.com

# Solo Ruta B (docker compose): dominio para el HTTPS automático de Caddy.
DOMAIN=REEMPLAZA_crm.tudominio.com

# --- Base de datos ------------------------------------------
# Ruta B usa el servicio interno `postgres` del compose.
# Genera la contraseña con:  openssl rand -hex 24
POSTGRES_PASSWORD=REEMPLAZA_password_de_postgres
DATABASE_URL=postgresql://postgres:REEMPLAZA_password_de_postgres@postgres:5432/vocero

# --- Secretos de la aplicación ------------------------------
# Firma de sesiones. Genera con:  openssl rand -base64 32
BETTER_AUTH_SECRET=REEMPLAZA_secreto_de_sesiones

# Cifrado en reposo del token de WhatsApp (AES-256-GCM).
# DEBE ser exactamente 32 bytes en base64 (44 caracteres).
# Genera con:  openssl rand -base64 32
ENCRYPTION_KEY=REEMPLAZA_clave_de_cifrado_base64

# --- WhatsApp (webhook) -------------------------------------
# Token de verificación del webhook. Es también el segmento secreto
# de la URL del webhook: /api/webhooks/wa/<este_valor>
# Genera con:  openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=REEMPLAZA_token_de_verificacion

# OPCIONAL (recomendado en modo directo): App Secret de tu app de Meta
# para validar la firma de cada webhook (x-hub-signature-256).
# Se obtiene en developers.facebook.com → tu app → Configuración → Básica.
# En modo agencia normalmente se deja vacío (la URL secreta protege el webhook).
# META_APP_SECRET=

# Versión de la Graph API (déjala así salvo que sepas por qué cambiarla).
META_GRAPH_API_VERSION=v25.0

# --- Inteligencia artificial (opcional) ---------------------
# Sin token, el CRM funciona completo excepto Agente y Laboratorio.
# Crea tu key en https://openrouter.ai → Keys (o usa cualquier proveedor
# compatible con la API de OpenRouter cambiando OPENROUTER_BASE_URL).
# OPENROUTER_API_TOKEN=
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# Modelo que CONVERSA con el cliente (ej.: anthropic/claude-sonnet-4.5)
# OPENROUTER_MODEL=
#
# Modelo que LEE MEDIOS: notas de voz, imágenes y cartas de catálogo.
# Si se omite, usa el conversacional — lo de siempre — pero avisa por log.
#
# ⚠️ NO TODO MODELO OYE. Compruébalo antes de cambiar el conversacional:
#    curl -s https://openrouter.ai/api/v1/models | grep -A3 '"tu/modelo"'
# y mira `input_modalities`. `openai/gpt-5-mini` declara "text, image, file":
# SIN audio. Antes del 21-sep-2026 una sola variable mandaba sobre las dos
# cosas, así que cambiar el modelo por costo habría dejado sin entender 805
# notas de voz al mes en cinco negocios, y sin ningún error visible: el bot
# simplemente no contesta a quien le habla. De ahí que sean dos variables.
# OPENROUTER_TRANSCRIPTION_MODEL=
#
# Modelo del juez del Laboratorio (si se omite, usa el conversacional)
# OPENROUTER_JUDGE_MODEL=
# Modelos SALVAVIDAS, en orden. Vacíos = sin salvavidas (un solo modelo).
# Solo entran cuando el anterior agotó sus tres intentos y no devolvió nada
# usable — nunca porque una respuesta parezca mala, que no tiene detector.
# Agotada la cadena entera, el rescate sigue siendo una PERSONA: los
# salvavidas se meten ANTES de la derivación, nunca en su lugar.
# ⚠️ El modelo que de verdad contestó sale en la traza de cada turno
# (`modelo=`). Míralo ahí antes de creer lo que dice esta variable: en agosto
# quedó puesta en el servidor después de retirarse del código, y Sonnet estuvo
# atendiendo clientes reales durante semanas sin que nadie lo viera.
# OPENROUTER_FALLBACK_MODEL=
# OPENROUTER_FALLBACK_MODEL_2=

# --- Operación (opcional) -----------------------------------
# Reabrir el registro público después de la primera organización.
# ALLOW_SIGNUP=true

# Milisegundos de agrupación de mensajes antes del turno del agente (default 6000).
# AGENT_COALESCE_MS=6000

# --- Worker de campañas (Fase 10B-10N, opcional) -------------
# Apagado por defecto A PROPÓSITO: un envío masivo real solo debe empezar
# cuando alguien lo enciende explícitamente. "0"/vacío/ausente = apagado.
# Documentada aquí solo para que quede a la vista en la config de
# EasyPanel — el código ya es seguro sin esto.
CAMPAIGN_WORKER_ENABLED=0
# Envíos de campaña en vuelo a la vez, todas las organizaciones (default 2).
# CAMPAIGN_WORKER_CONCURRENCY=2
# Cada cuánto se sondea la cola de campañas, en ms (default 2000).
# CAMPAIGN_WORKER_POLL_MS=2000
# Techo de seguridad de Korex por organización — no el límite real de
# YCloud/Meta (default 20 envíos por ventana de 60000 ms).
# CAMPAIGN_RATE_LIMIT_MAX=20
# CAMPAIGN_RATE_LIMIT_WINDOW_MS=60000
