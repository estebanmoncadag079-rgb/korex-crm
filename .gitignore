# --- Secretos (NUNCA al control de versiones) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- MCP local con tokens (si lo personalizas con secretos en claro) ---
# .mcp.json se commitea SOLO si usa ${VAR} (sin tokens en claro). Si metes
# secretos directos, ignóralo y deja únicamente .mcp.json.example.
# .mcp.json

# --- Dependencias / build (cuando el starter ya tenga app encima) ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# --- Logs y temporales ---
*.log
npm-debug.log*
pnpm-debug.log*
.cache/
tmp/
.tmp/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Claude Code: estado local (no compartir) ---
# La memoria de subagentes (.claude/agent-memory/) SÍ se versiona (es memoria de
# proyecto compartida con el equipo). La config local de la sesión, no:
.claude/settings.local.json
.playwright-mcp/
# Los bundles que dejan los scripts de prueba (`probar:citas`, `probar:agente`).
# Sin esto, correr una prueba deja un fichero de 150 KB que el lint intenta
# revisar y llena la salida de errores de código que no es nuestro.
.tmp-seed-demo.mjs
.tmp-probar-citas.mjs
.tmp-probar-agente.mjs
.tmp-fichas.mjs
.tmp-regenerar.mjs
.tmp-migrar-churra.mjs
.tmp-lab.mjs
.tmp-pedidos.mjs
.tmp-escenarios.mjs
escenarios-reporte.json

# El worker de pdf.js lo copia `prebuild` desde node_modules en cada build
# (scripts/copiar-worker-pdf.mjs): así su versión siempre coincide con la de la
# librería y no se versiona un binario de 1 MB.
public/pdf.worker.min.mjs
