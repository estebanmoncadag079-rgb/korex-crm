+/**
+ * ¿Hay un pedido en curso que todavía no se cierra? Con productos y sin
+ * confirmar. Es la condición para exigir que cada mensaje AVANCE: el objetivo
+ * del bot es cerrar el pedido (instrucción del dueño, 25-sep-2026).
+ */
+export function pedidoAbierto(
+  estado: { items: unknown[]; confirmado?: boolean | null } | null | undefined
+): boolean {
+  return !!estado && estado.items.length > 0 && estado.confirmado !== true;
+}
+
+/**
+ * La corrección cuando, a mitad del pedido, el mensaje no pide nada. Caso real
+ * (MALIA, 25-sep-2026): "Perfecto Esteban, ya lo anoté 🙂" con la dirección
+ * pendiente; el cliente tuvo que escribir "gracias" para que el bot siguiera.
+ * `falta` es la misma lista que el backend le da al modelo como TE FALTA.
+ */
+export function correccionDeTurnoSinAvance(falta: string[]): string {
+  return `ALTO. Tu mensaje no le pide nada al cliente y el pedido sigue abierto: se queda sin saber qué contestar y la venta se detiene. Tu objetivo es CERRAR el pedido. Conserva lo que dijiste y termina el mensaje pidiendo lo que falta, en este orden: ${falta.join(", ")}. Si son datos de contacto o de entrega, pídelos juntos en una sola pregunta. Responde ÚNICAMENTE el objeto JSON.`;
+}
+
+/**
+ * Si ni corregido avanza, la pregunta la pone el backend: nunca queda un turno
+ * muerto a mitad del pedido.
+ */
+export function preguntaDeLoQueFalta(falta: string[]): string {
+  if (falta.length === 0) return "¿Te muestro el resumen para confirmar tu pedido? 😊";
+  return `Para seguir con tu pedido, ¿me compartes ${falta[0]}? 😊`;
+}
+
 /** La corrección cuando aplaza el resumen teniendo la hoja lista. */
 export const CORRECCION_DE_RESUMEN_APLAZADO =
   "ALTO. Le dijiste al cliente que 'ahora preparas' el resumen, o le ofreciste mostrarlo, pero no lo mostraste en este mensaje: el cliente se queda esperando y el pedido no avanza. La hoja del pedido YA está completa. Muestra el resumen COMPLETO AHORA, en ESTE mismo mensaje —cada producto con su cantidad y precio, los datos de entrega, la línea del domicilio si aplica, y el total con su cifra— y pídele que confirme. No lo dejes para el mensaje siguiente. Responde ÚNICAMENTE el objeto JSON.";
