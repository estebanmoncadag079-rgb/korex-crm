{
  "name": "vocero-crm",
  "version": "1.0.0",
  "description": "CRM de WhatsApp open source y self-hosted con agente de IA y Laboratorio de auto-evaluación",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copiar-worker-pdf.mjs",
    "prebuild": "node scripts/copiar-worker-pdf.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:demo": "esbuild scripts/seed/demo.ts --bundle --platform=node --format=esm --outfile=.tmp-seed-demo.mjs --alias:@=./src --packages=external && node .tmp-seed-demo.mjs",
    "fichas:clientes": "esbuild scripts/fichas-de-clientes.ts --bundle --platform=node --format=esm --outfile=.tmp-fichas.mjs --alias:@=./src --packages=external && node .tmp-fichas.mjs",
